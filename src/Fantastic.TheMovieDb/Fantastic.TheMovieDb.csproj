<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net90;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<Authors>lfoust</Authors>
		<VersionPrefix>2.1.0</VersionPrefix>
		<PackageProjectUrl>https://github.com/lfoust/Fantastic</PackageProjectUrl>
		<RepositoryUrl>https://github.com/lfoust/Fantastic</RepositoryUrl>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<Version>$(VersionPrefix)</Version>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="9.0.11" Condition="'$(TargetFramework)' == 'net90'" />
		<PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
		<PackageReference Include="System.Net.Http.Json" Version="10.0.0" />
		<PackageReference Include="Fantastic.FileSystem" Version="2.0.0" />
	</ItemGroup>

</Project>
